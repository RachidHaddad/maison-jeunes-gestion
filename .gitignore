* {
  box-sizing: border-box;
}

:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --panel-alt: #edf4ff;
  --primary: #1d4ed8;
  --primary-dark: #123db4;
  --accent: #13b5a7;
  --text: #172033;
  --muted: #5f6d88;
  --line: #dfe8f3;
  --shadow: 0 18px 45px rgba(29, 78, 216, 0.12);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #eef4ff 0%, #f8fbff 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
}

.page-shell {
  max-width: 1240px;
  margin: 0 auto;
  padding: 24px 24px 64px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(223, 232, 243, 0.9);
  border-radius: 20px;
  position: sticky;
  top: 16px;
  z-index: 10;
  box-shadow: 0 10px 30px rgba(49, 91, 175, 0.06);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: white;
  font-weight: 800;
}

.brand-title {
  margin: 0;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand-subtitle {
  color: var(--muted);
  font-size: 0.76rem;
}

.main-nav {
  display: flex;
  gap: 24px;
  font-weight: 500;
  color: var(--muted);
}

.main-nav a:hover {
  color: var(--text);
}

.primary-button,
.secondary-button,
.role-button,
.tiny-button {
  border: none;
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-button {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  padding: 12px 18px;
  font-weight: 600;
  box-shadow: 0 12px 22px rgba(29, 78, 216, 0.2);
}

.primary-button.small {
  padding: 9px 14px;
  font-size: 0.8rem;
}

.secondary-button {
  background: #eaf1ff;
  color: var(--primary);
  border: 1px solid #d7e3ff;
  padding: 11px 18px;
  font-weight: 600;
}

.primary-button:hover,
.secondary-button:hover,
.role-button:hover,
.tiny-button:hover {
  transform: translateY(-1px);
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 28px;
  align-items: center;
  padding: 52px 0 20px;
}

.eyebrow {
  display: inline-block;
  background: var(--panel-alt);
  color: var(--primary);
  border-radius: 999px;
  padding: 8px 12px;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.hero-copy h1 {
  margin: 18px 0 18px;
  font-size: clamp(2.6rem, 5vw, 4rem);
  line-height: 1.05;
  letter-spacing: -0.06em;
}

.hero-copy p {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.06rem;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.hero-badges {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 26px;
}

.hero-badges span {
  background: #fff;
  border: 1px solid var(--line);
  padding: 8px 12px;
  border-radius: 999px;
  color: var(--muted);
  font-size: 0.84rem;
}

.hero-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--line);
  border-radius: 26px;
  box-shadow: var(--shadow);
}

.summary-card {
  padding: 30px 28px;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(135deg, #e8f1ff 0%, #ffffff 100%);
}

.panel-label {
  margin: 0 0 8px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

.summary-card h2 {
  font-size: 3.2rem;
  margin: 0 0 20px;
  letter-spacing: -0.06em;
}

.mini-bars {
  display: flex;
  gap: 10px;
  height: 80px;
  align-items: end;
}

.mini-bars span {
  flex: 1;
  border-radius: 10px 10px 0 0;
  background: linear-gradient(180deg, rgba(19, 181, 167, 0.85), rgba(29, 78, 216, 0.7));
}

.mini-bars span:nth-child(1) { height: 35%; }
.mini-bars span:nth-child(2) { height: 48%; }
.mini-bars span:nth-child(3) { height: 64%; }
.mini-bars span:nth-child(4) { height: 84%; }
.mini-bars span:nth-child(5) { height: 100%; }

.mini-card {
  padding: 22px 24px;
}

.mini-card h3 {
  margin: 4px 0 6px;
  font-size: 2rem;
}

.mini-card small {
  color: var(--muted);
}

.feature-strip {
  margin-top: 26px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  text-align: center;
}

.feature-strip > div {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px 14px;
}

.feature-strip strong {
  display: block;
  font-size: 2rem;
  letter-spacing: -0.05em;
}

.feature-strip span {
  color: var(--muted);
}

.features,
.activities,
.dashboard,
.notifications {
  margin-top: 80px;
}

.section-heading {
  margin-bottom: 24px;
}

.section-heading h2 {
  margin: 12px 0 0;
  font-size: clamp(2rem, 3vw, 2.7rem);
  letter-spacing: -0.05em;
}

.split-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 16px;
}

.feature-grid,
.activity-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.info-card,
.activity-card,
.dashboard-panel,
.notification-list {
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.info-card {
  padding: 24px;
}

.icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, #edf4ff, #dfeeff);
  font-size: 1.6rem;
  margin-bottom: 16px;
}

.info-card h3,
.activity-card h3 {
  margin: 0 0 10px;
  font-size: 1.2rem;
}

.info-card p,
.activity-card ul,
.notify-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.activity-card {
  padding: 22px;
}

.activity-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.tag {
  background: #e9f8f5;
  color: #0a8676;
  font-weight: 700;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
}

.points {
  font-weight: 700;
  color: var(--primary);
}

.activity-card ul {
  list-style: none;
  padding: 0;
  margin: 0 0 16px;
}

.activity-card li + li {
  margin-top: 8px;
}

.capacity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-weight: 600;
}

.tiny-button {
  background: #ecf7ff;
  color: var(--primary);
  border: 1px solid #d7ebff;
  padding: 8px 12px;
  font-size: 0.8rem;
}

.role-switcher {
  display: inline-flex;
  gap: 10px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 8px;
  margin-bottom: 20px;
}

.role-button {
  background: transparent;
  color: var(--muted);
  padding: 10px 16px;
  font-weight: 700;
}

.role-button.active {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 12px 22px rgba(29, 78, 216, 0.2);
}

.dashboard-panel {
  padding: 24px;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 18px;
}

.dashboard-header h3 {
  margin: 0;
  font-size: 1.6rem;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.summary-box {
  padding: 18px;
  background: linear-gradient(135deg, #edf4ff, #f7faff);
  border-radius: 16px;
  border: 1px solid var(--line);
}

.summary-box span {
  display: block;
  color: var(--muted);
  margin-bottom: 8px;
}

.summary-box strong {
  font-size: 1.8rem;
  letter-spacing: -0.06em;
}

.dashboard-content {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 20px;
  margin-top: 22px;
}

.panel-list,
.leaderboard {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 20px;
}

.panel-list h4,
.leaderboard h4 {
  margin: 0 0 16px;
  font-size: 1.05rem;
}

.list-row,
.user-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-top: 1px solid var(--line);
}

.list-row:first-of-type,
.user-row:first-of-type {
  border-top: none;
}

.user-row {
  grid-template-columns: 42px 1fr auto;
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #cfe0ff, #dff9f6);
  color: var(--primary);
  display: grid;
  place-items: center;
  font-weight: 700;
}

.user-row strong,
.user-row small {
  display: block;
}

.user-row small {
  color: var(--muted);
}

.notification-list {
  padding: 18px;
}

.notify-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 12px 0;
  border-top: 1px solid var(--line);
}

.notify-item:first-child {
  border-top: none;
  padding-top: 0;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  margin-top: 9px;
  flex-shrink: 0;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding-top: 50px;
  margin-top: 60px;
  border-top: 1px solid var(--line);
}

.footer-links {
  display: flex;
  gap: 20px;
  color: var(--muted);
}

@media (max-width: 980px) {
  .feature-grid,
  .activity-grid,
  .feature-strip,
  .dashboard-content {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 18px;
  }
}

@media (max-width: 620px) {
  .page-shell {
    padding-left: 16px;
    padding-right: 16px;
  }

  .main-nav,
  .footer {
    display: none;
  }

  .feature-grid,
  .activity-grid,
  .feature-strip,
  .summary-grid,
  .dashboard-content {
    grid-template-columns: 1fr;
  }

  .hero-copy h1 {
    font-size: 2.4rem;
  }

  .split-heading,
  .dashboard-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
